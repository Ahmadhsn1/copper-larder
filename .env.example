# ── Copper Larder — environment ────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in your host's
# environment for deployment. Never commit real values.

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role key.
# Server-only. Every table has RLS enabled with no policies, so this is the
# only key that can read or write; without it /api/chat and /api/lead fail
# closed with a graceful fallback message.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Salts the HMAC applied to requester IPs before
# they are stored — raw IPs are never persisted or logged.
IP_HASH_SALT=

# Optional — HTTP Basic Auth for the /dashboard operations view.
# When DASHBOARD_PASSWORD is unset the dashboard is left open (local dev only).
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=
